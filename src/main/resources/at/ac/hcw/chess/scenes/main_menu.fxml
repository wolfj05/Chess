<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="18"
      style="-fx-padding: 30;">

    <Label text="MENU" style="-fx-font-size: 32; -fx-font-weight: bold;"/>

    <Button fx:id="continueButton" text="CONTINUE" prefWidth="180"/>
    <Button fx:id="exitButton" text="EXIT" prefWidth="180"/>
    <Button fx:id="restartButton" text="RESTART" prefWidth="180"/>
    <Button fx:id="revangeButton" text="REVANGE" prefWidth="180"/>


</VBox>
