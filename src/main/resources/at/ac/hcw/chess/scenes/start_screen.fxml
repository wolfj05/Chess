<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           style="-fx-background-color: white;">

    <!-- CARD / Rahmen -->
    <StackPane prefWidth="900" prefHeight="520"
               style="-fx-background-color: #f7f7f7;
                      -fx-background-radius: 28;
                      -fx-border-color: #444444;
                      -fx-border-width: 6;
                      -fx-border-radius: 28;">

        <!-- INHALT (zentriert) -->
        <VBox alignment="CENTER" spacing="26" style="-fx-padding: 55;">

            <!-- Title -->
            <Label text=" Welcome!! LET'S PLAY CHESS"
                   style="-fx-font-size: 44; -fx-font-weight: 800;"/>

            <!-- MAIN ROW -->
            <HBox alignment="CENTER" spacing="70">

                <!-- LEFT: Player I + Player II (gleiche X-Position) -->
                <VBox spacing="22" alignment="CENTER_LEFT">

                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Player I" style="-fx-font-size: 16; -fx-font-weight: 800;"/>
                        <TextField fx:id="player1Field"
                                   promptText="Name eingeben"
                                   prefWidth="360"
                                   style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 10;"/>
                    </VBox>

                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Player II" style="-fx-font-size: 16; -fx-font-weight: 800;"/>
                        <TextField fx:id="player2Field"
                                   promptText="Name eingeben"
                                   prefWidth="360"
                                   style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 10;"/>
                    </VBox>

                </VBox>

                <!-- CENTER: Icons -->
                <VBox alignment="CENTER" spacing="14">
                    <ImageView fx:id="whitePieceIcon" fitWidth="78" fitHeight="78" preserveRatio="true"/>
                    <Label text="⇅" style="-fx-font-size: 26; -fx-font-weight: 800;"/>
                    <ImageView fx:id="blackPieceIcon" fitWidth="78" fitHeight="78" preserveRatio="true"/>
                </VBox>

                <!-- RIGHT: Random -->
                <VBox alignment="CENTER" spacing="12">
                    <Button fx:id="randomButton"
                            text="Random"
                            prefWidth="190"
                            prefHeight="44"
                            style="-fx-background-radius: 14; -fx-font-weight: 800;"/>
                </VBox>

            </HBox>

            <!-- ACTION BUTTONS -->
            <HBox alignment="CENTER" spacing="18">
                <Button fx:id="startButton"
                        text="Start Game"
                        prefWidth="220"
                        prefHeight="44"
                        style="-fx-background-radius: 14; -fx-font-weight: 800;"/>
                <Button fx:id="exitButton"
                        text="End Game"
                        prefWidth="220"
                        prefHeight="44"
                        style="-fx-background-radius: 14; -fx-font-weight: 800;"/>
            </HBox>

        </VBox>

        <!-- MUTE: Overlay unten rechts mit Abstand -->
        <ToggleButton fx:id="muteToggle"
                      text="Mute"
                      prefWidth="92"
                      prefHeight="92"
                      style="-fx-background-radius: 999; -fx-font-weight: 800;"
                      StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets top="0" right="40" bottom="40" left="0"/>
            </StackPane.margin>
        </ToggleButton>

    </StackPane>

</StackPane>
